{
  "name": "quixpos2jtl",
  "version": "1.1.0",
  "description": "Electron tray app + REST API service for MSSQL database",
  "main": "src/main.js",
  "bin": {
    "quixpos2jtl": "bin/quixpos2jtl.js"
  },
  "pkg": {
    "scripts": [
      "src/config.js",
      "src/service/**/*.js"
    ],
    "bytecode": false,
    "public": true,
    "publicPackages": [
      "*"
    ],
    "ignore": [
      "open",
      "electron",
      "electron-builder",
      "electron-winstaller",
      "node-windows"
    ]
  },
  "scripts": {
    "start": "electron .",
    "service:start": "node src/service/server.js",
    "service:settings": "node src/service/server.js --settings",
    "service:newpin": "node src/service/server.js --newpin",
    "service:dev": "node src/service/server.js -v",
    "service:dev:req": "node src/service/server.js --log-req",
    "service:dev:res": "node src/service/server.js --log-res",
    "build:cli:linux": "node scripts/build-cli-linux.js",
    "build:installer": "electron-builder --win nsis --publish never",
    "dist": "electron-builder --win nsis --publish never",
    "service:install": "node src/service/install.js",
    "service:uninstall": "node src/service/install.js --uninstall"
  },
  "author": "QuixPOS",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "mssql": "^12.7.0",
    "node-windows": "^1.0.0-beta.8",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.quixpos.quixpos2jtl",
    "productName": "QuixPOS2JTL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "extraFiles": [
      {
        "from": "assets/QuixPOS2JTL-CLI.cmd",
        "to": "QuixPOS2JTL-CLI.cmd"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuixPOS2JTL",
      "uninstallDisplayName": "QuixPOS2JTL",
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@36.9.5": true
  }
}
